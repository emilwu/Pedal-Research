#!/usr/bin/env bash
#
# 跨 repo 路徑驗證
#
# 起因：2026-03-09 Planning 把 development/designs/ 分流為 web/ 與 app/，
# 但兩個產品 repo 的 .claude/ 共 41 處硬編碼路徑沒跟上。8 天後才發現，
# 期間 4 份文件被寫進廢棄路徑。人工維護索引在這個工作區失敗過一次。
#
# 實際驗證邏輯在 verify-paths.py。這支只負責在 commit 時呼叫它。
#
# 安裝：git config core.hooksPath .githooks
# 略過：git commit --no-verify
#
# 看整個 repo 的狀況：   .githooks/verify-paths.py --all
# 看整個工作區的狀況：   .githooks/verify-paths.py --workspace
#
set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERIFIER="${HOOK_DIR}/verify-paths.py"

if [ ! -f "$VERIFIER" ]; then
  {
    echo ""
    echo "⚠ 找不到 ${VERIFIER}，路徑驗證未執行。"
    echo "  這支 hook 需要與 verify-paths.py 放在同一個目錄。"
    echo ""
  } >&2
  exit 0
fi

if ! command -v python3 >/dev/null; then
  {
    echo ""
    echo "⚠ 找不到 python3，路徑驗證未執行。"
    echo "  安裝 Xcode Command Line Tools 後這支 hook 才會生效："
    echo "    xcode-select --install"
    echo ""
  } >&2
  exit 0
fi

exec python3 "$VERIFIER" --staged
